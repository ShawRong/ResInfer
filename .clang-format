BasedOnStyle: Google
UseTab: Never
IndentWidth: 2
ColumnLimit: 80

# Match vLLM's C++ formatting convention.
DerivePointerAlignment: false
PointerAlignment: Left

# Reordering CUTLASS/vLLM include blocks can break builds.
SortIncludes: false

AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
IndentPPDirectives: BeforeHash

IncludeCategories:
  - Regex:           '^<'
    Priority:        4
  - Regex:           '^"(llvm|llvm-c|clang|clang-c|mlir|mlir-c)/'
    Priority:        3
  - Regex:           '^"(qoda|\.\.)/'
    Priority:        2
  - Regex:           '.*'
    Priority:        1
