# Local runner scratch suites.
# Keep production/reusable suites under tests/runner/suites/*.yaml.
# Put one-off experiments here so they do not pollute git status.
/tests/runner/suites/_tmp/*
!/tests/runner/suites/_tmp/README.md

# Local scratch scripts.
/scripts/_tmp/*
!/scripts/_tmp/README.md
/.litellm_cache

# Local machine config. Tracked configs are OSS-safe defaults.
/configs/*.local.yaml
